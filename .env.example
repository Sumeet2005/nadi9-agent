# NADI-9 Environment Configuration Settings Example

# Application Environment
NADI9_ENV=development
NADI9_LOG_LEVEL=INFO

# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30.0
NADI9_LLM_PROVIDER=mock

# Budget & Usage Enforcement Settings
NADI9_MAX_BUDGET=10.0
NADI9_MAX_MODEL_CALLS=25
NADI9_MAX_TOOL_CALLS=50
NADI9_RETRIEVAL_TOP_K=5

# Database & Checkpoint Persistence
NADI9_DATABASE_URL=sqlite:///nadi9.db
NADI9_CHECKPOINT_DB_PATH=nadi9_checkpoints.db

# API Settings
NADI9_API_HOST=0.0.0.0
NADI9_API_PORT=8000
NADI9_OUTPUT_DIR=outputs
